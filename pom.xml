<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.swisseph</groupId>
    <artifactId>swisseph-java-ffm</artifactId>
    <version>0.5.0</version>
    <packaging>jar</packaging>

    <name>Swiss Ephemeris Java FFM</name>
    <description>Java bindings for Swiss Ephemeris using the Foreign Function and Memory API.</description>
    <url>https://github.com/honsali/swisseph-java-ffm</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>honsali</id>
            <name>honsali</name>
            <url>https://github.com/honsali</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/honsali/swisseph-java-ffm.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/honsali/swisseph-java-ffm.git</developerConnection>
        <url>https://github.com/honsali/swisseph-java-ffm</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/honsali/swisseph-java-ffm</url>
        </repository>
    </distributionManagement>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
          Reproducible builds: fixes every timestamp inside the produced archives,
          so the same source tree always yields byte-identical artifacts. Bump this
          to the release date whenever the version is bumped.
          See https://maven.apache.org/guides/mini/guide-reproducible-builds.html
        -->
        <project.build.outputTimestamp>2026-08-29T00:00:00Z</project.build.outputTimestamp>
        <junit.version>6.0.3</junit.version>
        <!--
          Granting native access to the module under test. Without it the JDK
          prints a warning today and will refuse the downcall in a future release.
        -->
        <native.access.args>--enable-native-access=org.swisseph.ffm,ALL-UNNAMED</native.access.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!--
              AGPL-3.0 section 4 requires a copy of the licence to reach every
              recipient, so it travels inside the artifacts rather than only in
              the repository.
            -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <argLine>${native.access.args}</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <includePom>true</includePom>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <notimestamp>true</notimestamp>
                    <quiet>true</quiet>
                    <doclint>all,-missing</doclint>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
